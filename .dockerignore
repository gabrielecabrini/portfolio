# node_modules is the one that matters: leaving them in would push
# the build context from a few MB to several GB.
node_modules
.astro
dist
coverage

.git
.gitignore
.github

# Editor and agent tooling — never read by the build, and excluding them keeps an
# unrelated settings change from invalidating the yarn install layer.
.idea
.vscode
.editorconfig
.claude
.agents
skills-lock.json

Dockerfile
.dockerignore
*.md
