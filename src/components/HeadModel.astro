<canvas class="head" width="320" height="320" aria-hidden="true"></canvas>

<script>
  // Decorative low-poly head that looks at the cursor (or taps, on touch). Skipped when the canvas is hidden by a parent.
  const canvas = document.querySelector<HTMLCanvasElement>('canvas.head');
  if (canvas && canvas.offsetParent) {
    // Library chunks and the model download in parallel
    const [THREE, { GLTFLoader }, { MeshoptDecoder }, model] = await Promise.all([
      import('three'),
      import('three/addons/loaders/GLTFLoader.js'),
      import('three/addons/libs/meshopt_decoder.module.js'),
      fetch('/assets/models/head.glb').then((r) => r.arrayBuffer()),
    ]);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    // Firefox on macOS may silently deny MSAA: supersample instead
    const msaa = renderer.getContext().getContextAttributes()?.antialias;
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2) * (msaa ? 1 : 2));
    // Buffer from the displayed size, not the 320 attribute, so the small mobile head draws fewer pixels
    renderer.setSize(canvas.clientWidth, canvas.clientHeight, false);
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 10);
    camera.position.z = 4;
    // Low ambient so flat facets read; near-side key from high-right so half the head falls into
    // shadow and turning visibly moves the lit area, weak fill on the left, and a top light from above-behind that catches hair, shoulders and collar
    scene.add(new THREE.HemisphereLight(0xffffff, 0x202020, 0.08));
    for (const [intensity, x, y, z] of [
      [4, 2.5, 1.2, 0.6],
      [0.15, -2.5, -0.3, 2],
      [0.8, -0.5, 3, -1],
    ] as const) {
      const light = new THREE.DirectionalLight(0xffffff, intensity);
      light.position.set(x, y, z);
      scene.add(light);
    }

    const { scene: head } = await new GLTFLoader()
      .setMeshoptDecoder(MeshoptDecoder)
      .parseAsync(model, '');
    const material = new THREE.MeshStandardMaterial({ flatShading: true, roughness: 0.6 });
    head.traverse((o) => {
      if (o instanceof THREE.Mesh) o.material = material;
    });
    scene.add(head);

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const target = { x: 0, y: 0 };
    // Easing rate (1/s): drops on leave/enter so the head turns slowly, then ramps back up to FOLLOW
    const FOLLOW = 12;
    const SLOW = 1.5;
    const RAMP = 6;
    let rate = FOLLOW;
    let tracking = false;
    let last = 0;

    // Renders only while the head is moving; any input calls wake() to restart the loop
    const loop = (t: number) => {
      // Time-based, so 144 Hz screens don't turn faster (same reason as donut.astro)
      const dt = last ? Math.min((t - last) / 1000, 0.1) : 0;
      last = t;
      if (tracking) rate = Math.min(FOLLOW, rate + RAMP * dt);
      const f = reduced ? 1 : 1 - Math.exp(-rate * dt);
      head.rotation.y += (target.y - head.rotation.y) * f;
      head.rotation.x += (target.x - head.rotation.x) * f;
      renderer.render(scene, camera);
      // 1e-3 rad is invisible and lets a slow glance settle (~4.5s) before the next one starts
      if (
        Math.abs(target.y - head.rotation.y) < 1e-3 &&
        Math.abs(target.x - head.rotation.x) < 1e-3
      ) {
        renderer.setAnimationLoop(null);
        last = 0;
      }
    };
    const wake = () => renderer.setAnimationLoop(loop);

    const setColor = () => {
      material.color.set(getComputedStyle(canvas).getPropertyValue('--accent').trim());
      wake();
    };
    setColor();
    new MutationObserver(setColor).observe(document.documentElement, {
      attributeFilter: ['data-theme'],
    });

    // Slowly turn towards a fixed point, no longer following the pointer
    const easeTo = (x: number, y: number) => {
      tracking = false;
      rate = SLOW;
      target.x = x;
      target.y = y;
      wake();
    };

    // Touch devices have no hover: the head glances around on its own between taps
    const idleGlance = !reduced && matchMedia('(hover: none)').matches;
    let idle: ReturnType<typeof setTimeout> | undefined;
    const glance = () => {
      easeTo(THREE.MathUtils.randFloat(-0.2, 0.2), THREE.MathUtils.randFloat(-0.5, 0.5));
      idle = setTimeout(glance, THREE.MathUtils.randFloat(5000, 8000));
    };
    if (idleGlance) idle = setTimeout(glance, 1500);

    const aim = (e: PointerEvent) => {
      if (idleGlance) {
        // Keep looking at the tapped point for a while before glancing around again
        clearTimeout(idle);
        idle = setTimeout(glance, 4000);
      }
      if (!tracking) {
        tracking = true;
        rate = SLOW;
      }
      const r = canvas.getBoundingClientRect();
      // Angle towards the pointer, relative to the canvas centre, clamped to a plausible neck range
      target.y = THREE.MathUtils.clamp(
        ((e.clientX - r.left - r.width / 2) / innerWidth) * 2,
        -0.6,
        0.6,
      );
      target.x = THREE.MathUtils.clamp(
        (e.clientY - r.top - r.height / 2) / innerHeight,
        -0.25,
        0.25,
      );
      wake();
    };
    addEventListener('pointermove', aim);
    // On touch, pointermove fires only while dragging: a single tap needs pointerdown
    addEventListener('pointerdown', aim);
    // Cursor left the window: slowly ease back to neutral
    document.documentElement.addEventListener('mouseleave', () => easeTo(0, 0));

    // Fades in only once the model is there to show
    canvas.classList.add('ready');
  }
</script>

<style>
  .head {
    display: block;
    /* Pages can shrink it, e.g. on mobile */
    width: var(--head-size, 320px);
    height: var(--head-size, 320px);
    opacity: 0;
    transition: opacity 0.4s;
  }

  .head.ready {
    opacity: 1;
  }
</style>
