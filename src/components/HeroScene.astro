<canvas class="hero-scene" aria-hidden="true"></canvas>

<script>
  // The CSS breakpoint decides: a display: none canvas never intersects, so phones never
  // download the scene, and widening the window past the breakpoint still starts it
  const canvas = document.querySelector<HTMLCanvasElement>('.hero-scene')!;
  const shown = new IntersectionObserver(async ([entry]) => {
    if (!entry!.isIntersecting) return;
    shown.disconnect();
    const [{ start }, scene] = await Promise.all([
      import('../scripts/hero-scene'),
      fetch('/hero-scene.json').then((response) => response.json()),
    ]);
    start(canvas, scene);
  });
  shown.observe(canvas);
</script>

<style>
  .hero-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  /* Faint enough to stay behind the text, never compete with it */
  .hero-scene.ready {
    opacity: 0.35;
  }

  :global([data-theme='light']) .hero-scene.ready {
    opacity: 0.3;
  }

  @media (max-width: 700px) {
    .hero-scene {
      display: none;
    }
  }
</style>
