---
import { localePath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Current path without the /en prefix, e.g. "/about". */
  path: string;
  /** Page has no twin in the other language (404, easter eggs): the toggle goes home. */
  noTwin?: boolean;
}

const { lang, path, noTwin = false } = Astro.props;
const other: Lang = lang === 'it' ? 'en' : 'it';
const switchHref = localePath(other, noTwin ? '/' : path);
const links = [
  { href: '/', label: t(lang, 'nav.home') },
  { href: '/about', label: t(lang, 'nav.about') },
  { href: '/cv', label: 'CV' },
  { href: '/experience', label: t(lang, 'nav.experience') },
  { href: '/projects', label: t(lang, 'nav.projects') },
].map((link) => ({ ...link, active: link.href === path, href: localePath(lang, link.href) }));
---

<header>
  <div class="header-inner">
    <a class="brand" href={localePath(lang, '/')}>
      gc<span class="brand-dot">.</span>
    </a>
    <nav class="nav-desktop">
      {links.map((link) => (
        <a href={link.href} class:list={{ active: link.active }}>
          {link.label}
        </a>
      ))}
    </nav>
    <a
      class="lang-toggle"
      href={switchHref}
      hreflang={other}
      aria-label={t(lang, 'nav.switchLang')}
    >
      <img
        src={other === 'en' ? 'https://flagcdn.com/gb.svg' : 'https://flagcdn.com/it.svg'}
        alt=""
        class="flag-icon"
        aria-hidden="true"
      />
      {other.toUpperCase()}
    </a>
  </div>
</header>
<!-- Outside <header> so it scrolls away on mobile instead of staying pinned -->
<nav class="nav-mobile">
  {links.map((link) => (
    <a href={link.href} class:list={{ active: link.active }}>
      {link.label}
    </a>
  ))}
</nav>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-bar-h);
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    border-bottom: 1px solid var(--border);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .brand {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.04em;
    margin-right: auto;
  }

  .brand:hover {
    color: var(--accent);
  }

  /* Same mark as the favicon: accent dot, pulled in because a monospace period
     sits centred in a full-width cell. */
  .brand-dot {
    color: var(--accent);
    margin-left: -0.2em;
  }

  .nav-desktop {
    display: flex;
    gap: 1.5rem;
  }

  .nav-mobile {
    display: none;
  }

  nav a {
    color: var(--muted);
    font-size: 0.9rem;
    transition: color 0.15s;
  }

  nav a:hover,
  nav a.active {
    color: var(--text);
  }

  .lang-toggle {
    background: none;
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
    transition:
      border-color 0.15s,
      color 0.15s;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    white-space: nowrap;
  }

  .lang-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .flag-icon {
    width: 16px;
    height: 11px;
    object-fit: cover;
    border-radius: 1px;
    flex-shrink: 0;
  }

  /* Underline animation on desktop nav links */
  .nav-desktop a {
    position: relative;
  }

  .nav-desktop a::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .nav-desktop a:hover::after {
    transform: scaleX(1);
  }

  /* ── Tablet: compact single row ── */
  @media (max-width: 768px) {
    .nav-desktop {
      gap: 1rem;
    }

    .nav-desktop a {
      font-size: 0.85rem;
    }
  }

  /* ── Mobile: brand + toggle stay pinned, the nav row below scrolls away ── */
  @media (max-width: 480px) {
    .header-inner {
      padding: 0 1rem;
    }

    .lang-toggle {
      font-size: 0.78rem;
      padding: 0.2rem 0.5rem;
    }

    .nav-desktop {
      display: none;
    }

    .nav-mobile {
      display: flex;
      height: var(--header-nav-h);
      border-bottom: 1px solid var(--border);
    }

    .nav-mobile a {
      font-size: 0.8rem;
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }
</style>
