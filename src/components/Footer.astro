---
import packageJson from '../../package.json';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<footer>
  <div class="footer-inner">
    <div class="footer-left">
      <span class="muted">© {new Date().getFullYear()} Gabriele Cabrini</span>
    </div>
    <div class="footer-right">
      <a
        class="muted repo-link sitemap-link"
        href="/sitemap-index.xml"
        target="_blank"
        rel="noopener noreferrer"
      >
        Sitemap
      </a>
      <a
        class="muted repo-link"
        href="https://github.com/gabrielecabrini/portfolio"
        target="_blank"
        rel="noopener noreferrer"
      >
        v{packageJson.version} ↗
      </a>
      <button class="theme-toggle" aria-label={t(lang, 'nav.switchTheme')}>
        <svg
          class="icon-sun"
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg
          class="icon-moon"
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
    </div>
  </div>
</footer>

<script>
  // The initial theme is set by the inline script in Base.astro, before first paint.
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset['theme'] === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset['theme'] = next;
    localStorage.setItem('theme', next);
  });
</script>

<style>
  footer {
    border-top: 1px solid var(--border);
    height: var(--footer-h);
  }

  .footer-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .muted {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  @media (max-width: 480px) {
    .sitemap-link {
      display: none;
    }
  }

  .footer-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .repo-link {
    transition: color 0.15s;
  }

  .repo-link:hover {
    color: var(--accent);
  }

  .theme-toggle {
    background: none;
    border: none;
    color: var(--muted);
    padding: 0;
    cursor: pointer;
    transition: color 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .theme-toggle:hover {
    color: var(--accent);
  }

  /* Show the icon of the theme a click switches to. */
  :global([data-theme='dark']) .icon-moon,
  :global([data-theme='light']) .icon-sun {
    display: none;
  }
</style>
