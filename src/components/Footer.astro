---
import { localePath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
// Set by GitHub Actions in the deploy job; absent in local and Docker builds.
const sha = process.env.GITHUB_SHA;
---

<footer>
  <div class="footer-inner">
    <div class="footer-left">
      <span class="muted">© {new Date().getFullYear()} Gabriele Cabrini</span>
    </div>
    <div class="footer-right">
      <a class="muted repo-link" href={localePath(lang, '/donut')} aria-label="Donut">
        🍩
      </a>
      <a class="muted repo-link hide-mobile" href={localePath(lang, '/pgp')}>
        PGP
      </a>
      <a
        class="muted repo-link hide-mobile"
        href="/sitemap-index.xml"
        target="_blank"
        rel="noopener noreferrer"
      >
        Sitemap
      </a>
      <a
        class="muted repo-link icon-link"
        href={`https://github.com/gabrielecabrini/portfolio${sha ? `/commit/${sha}` : ''}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t(lang, 'nav.sourceCode')}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>
        {sha && <span class="sha hide-mobile">{sha.slice(0, 7)} ↗</span>}
      </a>
      <button class="theme-toggle" aria-label={t(lang, 'nav.switchTheme')}>
        <svg
          class="icon-sun"
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="5" />
          <line x1="12" y1="1" x2="12" y2="3" />
          <line x1="12" y1="21" x2="12" y2="23" />
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
          <line x1="1" y1="12" x2="3" y2="12" />
          <line x1="21" y1="12" x2="23" y2="12" />
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
        </svg>
        <svg
          class="icon-moon"
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
    </div>
  </div>
</footer>

<script>
  // The initial theme is set by the inline script in Base.astro, before first paint.
  const root = document.documentElement;
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
  const osTheme = () => (systemDark.matches ? 'dark' : 'light');

  // Without a saved choice the site keeps following the OS, even while open.
  systemDark.addEventListener('change', () => {
    if (!localStorage.getItem('theme')) root.dataset['theme'] = osTheme();
  });

  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = root.dataset['theme'] === 'dark' ? 'light' : 'dark';
    root.dataset['theme'] = next;
    // Picking the OS theme again drops the override, so the site follows the OS from now on
    if (next === osTheme()) localStorage.removeItem('theme');
    else localStorage.setItem('theme', next);
  });
</script>

<style>
  footer {
    border-top: 1px solid var(--border);
    height: var(--footer-h);
  }

  .footer-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .muted {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  @media (max-width: 480px) {
    .hide-mobile {
      display: none;
    }
  }

  .footer-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .repo-link {
    transition: color 0.15s;
  }

  .icon-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .sha {
    font-size: 0.72rem;
  }

  .repo-link:hover {
    color: var(--accent);
  }

  .theme-toggle {
    background: none;
    border: none;
    color: var(--muted);
    padding: 0;
    cursor: pointer;
    transition: color 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .theme-toggle:hover {
    color: var(--accent);
  }

  /* Show the icon of the theme a click switches to. */
  :global([data-theme='dark']) .icon-moon,
  :global([data-theme='light']) .icon-sun {
    display: none;
  }
</style>
