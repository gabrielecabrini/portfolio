---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';

// GitHub Pages serves this one file for every unknown URL, /en/… included, so it
// can't know the visitor's language: the page is bilingual instead.
---

<Base lang="it" title="404" description={t('it', 'notFound.message')} noindex>
  <section class="not-found-page">
    <div class="not-found-inner">
      <div class="rustc">
        <h1 lang="en">
          <span class="err">error[E404]</span>
          <b>: route not found</b>
        </h1>
        <pre><span class="g"> --&gt;</span> router.rs:1:5
<span class="g">  |</span>
<span class="g">1 |</span> GET <span id="nf-path">/…</span>
<span class="g">  |</span>     <span class="err"><span id="nf-carets">^</span> <span lang="en">no route matches this path</span></span>
<span class="g">  |</span></pre>
        <pre class="notes"><span class="g">  =</span> <b>help</b>: {t('it', 'notFound.message')}
<span class="g">  =</span> <b>help</b>: <span lang="en">{t('en', 'notFound.message')}</span></pre>
      </div>
      <a href="/" class="btn-home" aria-label="Home">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="19" y1="12" x2="5" y2="12" />
          <polyline points="12 19 5 12 12 5" />
        </svg>
      </a>
    </div>
  </section>
  <script is:inline>
    document.getElementById('nf-path').textContent = location.pathname;
    document.getElementById('nf-carets').textContent = '^'.repeat(location.pathname.length);
  </script>
</Base>

<style>
  .not-found-page {
    --error: #f87171;
    --gutter: #60a5fa;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--header-h) - var(--footer-h));
    padding: 4rem 1.5rem;
  }

  .not-found-inner {
    max-width: 640px;
    /* Lets the flex item shrink below the unwrapped <pre> width so it scrolls instead */
    min-width: 0;
    margin: 0 auto;
  }

  .not-found-inner > * {
    animation: fade-up 0.45s ease both;
  }
  .not-found-inner > :nth-child(2) {
    animation-delay: 80ms;
  }

  /* Mimics rustc's output: one size, one font, bold red error, bold blue gutter */
  .rustc,
  .rustc pre {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    /* Keep "-->" literal instead of JetBrains Mono's arrow ligature */
    font-variant-ligatures: none;
  }

  .rustc h1 {
    /* Flex drops the whitespace Prettier puts between the two spans */
    display: flex;
    flex-wrap: wrap;
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: normal;
  }

  .rustc pre {
    margin: 0;
    padding: 0;
    background: none;
    border: none;
    /* Long paths scroll like a terminal instead of breaking the caret alignment */
    overflow-x: auto;
  }

  .rustc pre.notes {
    white-space: pre-wrap;
  }

  .err {
    color: var(--error);
    font-weight: 700;
  }

  .g {
    color: var(--gutter);
    font-weight: 700;
  }

  .rustc b {
    font-weight: 700;
  }

  .btn-home {
    display: inline-flex;
    margin-top: 1rem;
    padding: 0.65rem 1.6rem;
    background: var(--accent);
    color: var(--on-accent);
    border-radius: var(--radius);
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.15s;
  }

  .btn-home:hover {
    background: var(--accent-dim);
    color: var(--on-accent);
  }

  :global([data-theme='light']) .not-found-page {
    --error: #dc2626;
    --gutter: #2563eb;
  }

  @media (max-width: 480px) {
    .not-found-page {
      padding: 2.5rem 1rem;
      min-height: unset;
    }
  }
</style>
