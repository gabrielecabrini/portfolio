---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';

// GitHub Pages serves this one file for every unknown URL, /en/… included, so it
// can't know the visitor's language: the page is bilingual instead.
---

<Base lang="it" title="404" description={t('it', 'notFound.message')} noindex>
  <section class="not-found-page">
    <div class="not-found-inner">
      <h1 class="code">404</h1>
      <p class="message">{t('it', 'notFound.message')}</p>
      <p class="message" lang="en">
        {t('en', 'notFound.message')}
      </p>
      <a href="/" class="btn-home" aria-label="Home">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="19" y1="12" x2="5" y2="12" />
          <polyline points="12 19 5 12 12 5" />
        </svg>
      </a>
    </div>
  </section>
</Base>

<style>
  .not-found-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--header-h) - var(--footer-h));
    padding: 4rem 1.5rem;
    text-align: center;
  }

  .not-found-inner {
    max-width: 480px;
    margin: 0 auto;
  }

  .not-found-inner > * {
    animation: fade-up 0.45s ease both;
  }
  .not-found-inner > :nth-child(1) {
    animation-delay: 0ms;
  }
  .not-found-inner > :nth-child(2) {
    animation-delay: 80ms;
  }
  .not-found-inner > :nth-child(3) {
    animation-delay: 160ms;
  }
  .not-found-inner > :nth-child(4) {
    animation-delay: 240ms;
  }

  .code {
    font-size: clamp(4rem, 15vw, 7rem);
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: 1rem;
  }

  .message {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .btn-home {
    display: inline-flex;
    margin-top: 1rem;
    padding: 0.65rem 1.6rem;
    background: var(--accent);
    color: #fff;
    border-radius: var(--radius);
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.15s;
  }

  .btn-home:hover {
    background: var(--accent-dim);
    color: #fff;
  }

  @media (max-width: 480px) {
    .not-found-page {
      padding: 2.5rem 1rem;
      min-height: unset;
    }
  }
</style>
