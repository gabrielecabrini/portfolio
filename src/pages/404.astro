---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';

// Cloudflare serves this one file for every unknown URL, /en/… included, so it
// can't know the visitor's language: the page is bilingual instead.
---

<Base lang="it" title="404" description={t('it', 'notFound.message')} noindex>
  <section class="not-found-page">
    <div class="not-found-inner">
      <div class="rustc enter">
        <h1 lang="en">
          <span class="err">error[E404]</span>
          <b>: route not found</b>
        </h1>
        <pre><span class="g"> --&gt;</span> router.rs:1:5
<span class="g">  |</span>
<span class="g">1 |</span> GET <span id="nf-path">/…</span>
<span class="g">  |</span>     <span class="err"><span id="nf-carets">^</span><span class="label" lang="en"> no route matches this path</span></span>
<span class="g">  |</span></pre>
        <pre class="notes"><span class="note"><span class="g">  =</span> <b>help</b>: {t('it', 'notFound.message')}</span><span class="note" lang="en"><span class="g">  =</span> <b>help</b>: {t('en', 'notFound.message')}</span></pre>
      </div>
      <a href="/" class="btn-home enter" style="--i: 1">
        Home
      </a>
    </div>
  </section>
  <script is:inline>
    // Long paths are cut so the source line and its carets never need to scroll
    const path =
      location.pathname.length > 32 ? location.pathname.slice(0, 31) + '…' : location.pathname;
    document.getElementById('nf-path').textContent = path;
    document.getElementById('nf-carets').textContent = '^'.repeat(path.length);
  </script>
</Base>

<style>
  .not-found-page {
    --error: #f87171;
    --gutter: #60a5fa;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--header-h) - var(--footer-h));
    padding: 4rem 1.5rem;
  }

  .not-found-inner {
    max-width: 640px;
    /* Lets the flex item shrink below the unwrapped <pre> width so it scrolls instead */
    min-width: 0;
    margin: 0 auto;
  }

  /* Mimics rustc's output: one size, one font, bold red error, bold blue gutter */
  .rustc,
  .rustc pre {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    /* Keep "-->" literal instead of JetBrains Mono's arrow ligature */
    font-variant-ligatures: none;
  }

  .rustc h1 {
    /* Flex drops the whitespace Prettier puts between the two spans */
    display: flex;
    flex-wrap: wrap;
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: normal;
  }

  .rustc pre {
    margin: 0;
    padding: 0;
    background: none;
    border: none;
    /* Long paths scroll like a terminal instead of breaking the caret alignment */
    overflow-x: auto;
  }

  .rustc pre.notes {
    white-space: pre-wrap;
  }

  /* Hanging indent: wrapped text lines up after "  = help: ", as rustc does */
  .note {
    display: block;
    padding-left: 10ch;
    text-indent: -10ch;
  }

  .err {
    color: var(--error);
    font-weight: 700;
  }

  .g {
    color: var(--gutter);
    font-weight: 700;
  }

  .rustc b {
    font-weight: 700;
  }

  .btn-home {
    display: inline-flex;
    margin-top: 1rem;
    padding: 0.65rem 1.6rem;
    background: var(--accent);
    color: var(--on-accent);
    border-radius: var(--radius);
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.15s;
  }

  .btn-home:hover {
    background: var(--accent-dim);
    color: var(--on-accent);
  }

  :global([data-theme='light']) .not-found-page {
    --error: #dc2626;
    --gutter: #2563eb;
  }

  @media (max-width: 480px) {
    .rustc,
    .rustc pre {
      font-size: 0.75rem;
    }

    /* No room beside the carets on a phone: they alone mark the path */
    .label {
      display: none;
    }

    .not-found-page {
      padding: 2.5rem 1rem;
      min-height: unset;
    }
  }
</style>
