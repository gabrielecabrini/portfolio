---
import { Font } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import {
  CERTIFICATIONS,
  EDUCATION,
  LANGUAGES,
  SKILL_GROUPS,
  WORK_EXPERIENCES,
} from '../../data/experience';
import { EMAIL, SOCIAL_LINKS } from '../../data/social-links';
import { langPaths, pageLang, t } from '../../i18n';
import { sortForCv } from '../../lib/cv';
import { dateRange, displayUrl, formatMonthYear, workPlace } from '../../lib/format';

export const getStaticPaths = langPaths;
const lang = pageLang(Astro.params.lang);

const contactLinks = [EMAIL, ...SOCIAL_LINKS.filter((l) => l.href.includes('linkedin.com'))];
// Generated by scripts/cv-pdf.mjs from this very page after `astro build`.
const pdfHref = `/CV-GabrieleCabrini-${lang.toUpperCase()}.pdf`;
const buildDate = new Date().toLocaleDateString('it-IT');
---

<Base lang={lang} title="CV" description={t(lang, 'cv.seo.description')}>
  <Font cssVariable="--font-inter" slot="head" />

  <!-- ── Desktop toolbar ── -->
  <div class="cv-actions">
    <span class="cv-lang-hint">{t(lang, 'cv.lang.hint')}</span>
    <a class="cv-print-btn" href={pdfHref} download>
      {t(lang, 'cv.download')}
    </a>
  </div>

  <!-- ── Mobile: download only ── -->
  <div class="cv-mobile-msg">
    <p>{t(lang, 'cv.mobile.hint')}</p>
    <a class="cv-print-btn" href={pdfHref} download>
      {t(lang, 'cv.download')}
    </a>
  </div>

  <!-- ── CV paper ── -->
  <div class="cv-page" data-pdf-footer={t(lang, 'cv.footer.generated', { date: buildDate })}>
    <header class="cv-header">
      <img class="cv-photo" src="/assets/images/pfp.jpeg" alt="Gabriele Cabrini" decoding="async" />
      <div class="cv-header-info">
        <h1 class="cv-name">Gabriele Cabrini</h1>
        <p class="cv-role">{t(lang, 'home.subtitle')}</p>
        <p class="cv-location">{t(lang, 'cv.location')}</p>
        <div class="cv-contacts">
          {contactLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="cv-contact-link">
              {displayUrl(link.href)}
            </a>
          ))}
        </div>
      </div>
    </header>

    <hr class="cv-rule" />

    <section class="cv-section">
      <h2 class="cv-section-title">{t(lang, 'experience.work.title')}</h2>
      {sortForCv(WORK_EXPERIENCES).map((job) => {
        const place = workPlace(job, lang);
        return (
          <div class="cv-entry">
            <div class="cv-entry-meta">
              <span class="cv-entry-date">{dateRange(job.startDate, job.endDate, lang)}</span>
              <span class="cv-entry-company">{job.company}</span>
              {place && <span class="cv-entry-date">{place}</span>}
            </div>
            <div class="cv-entry-body">
              <strong class="cv-entry-role">{t(lang, job.roleKey)}</strong>
              <p class="cv-entry-desc">{t(lang, job.descriptionKey)}</p>
            </div>
          </div>
        );
      })}
    </section>

    <hr class="cv-rule" />

    <section class="cv-section">
      <h2 class="cv-section-title">{t(lang, 'experience.edu.title')}</h2>
      {EDUCATION.map((edu) => (
        <div class="cv-entry">
          <div class="cv-entry-meta">
            <span class="cv-entry-date">
              {edu.startDate} — {edu.endDate}
            </span>
            <span class="cv-entry-company">{edu.institution}</span>
            {edu.location && <span class="cv-entry-date">{edu.location}</span>}
          </div>
          <div class="cv-entry-body">
            <strong class="cv-entry-role">{t(lang, edu.qualificationKey)}</strong>
          </div>
        </div>
      ))}
    </section>

    <hr class="cv-rule" />

    <section class="cv-section">
      <h2 class="cv-section-title">{t(lang, 'experience.skills.title')}</h2>
      <dl class="cv-skills-list">
        {SKILL_GROUPS.map((group) => (
          <>
            <dt>{t(lang, group.categoryKey)}</dt>
            <dd>{group.skills.map((skill) => skill.name).join(' · ')}</dd>
          </>
        ))}
      </dl>
    </section>

    <hr class="cv-rule" />

    <section class="cv-section">
      <h2 class="cv-section-title">{t(lang, 'experience.languages.title')}</h2>
      <div class="cv-lang-grid">
        {LANGUAGES.map((language) => (
          <div class="cv-lang-entry">
            <strong>{language.name}</strong>
            {language.descriptionKey && <span> — {t(lang, language.descriptionKey)}</span>}
          </div>
        ))}
      </div>
    </section>

    {CERTIFICATIONS.length > 0 && (
      <>
        <hr class="cv-rule" />
        <section class="cv-section">
          <h2 class="cv-section-title">{t(lang, 'experience.certs.title')}</h2>
          {CERTIFICATIONS.map((cert) => (
            <div class="cv-cert-entry">
              <div class="cv-cert-meta">
                <span class="cv-entry-date">{formatMonthYear(cert.date, lang)}</span>
                <span>{cert.issuer}</span>
              </div>
              <div class="cv-cert-body">
                {cert.url ? (
                  <a href={cert.url} target="_blank" rel="noopener noreferrer" class="cv-cert-name">
                    {cert.name}
                  </a>
                ) : (
                  <strong>{cert.name}</strong>
                )}
              </div>
            </div>
          ))}
        </section>
      </>
    )}

    {lang === 'it' && (
      <p class="cv-gdpr">
        Autorizzo il trattamento dei dati personali contenuti nel mio curriculum vitae ai sensi del
        D.&nbsp;Lgs.&nbsp;196/2003 e del Regolamento UE 2016/679 (GDPR).
      </p>
    )}
  </div>
</Base>

<style>
  /* ── Screen wrapper ── */
  .cv-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 820px;
    margin: 2rem auto 1rem;
    padding: 0 1rem;
  }

  .cv-lang-hint {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .cv-print-btn {
    display: inline-block;
    line-height: normal;
    padding: 0.5rem 1.25rem;
    font-size: 0.88rem;
    font-weight: 500;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    cursor: pointer;
    transition:
      border-color 0.15s,
      background 0.15s;
  }

  .cv-print-btn:hover {
    border-color: var(--accent);
    background: var(--surface-hover);
  }

  /* ── Paper card ── */
  .cv-page {
    font-family: var(--font-inter);
    max-width: 820px;
    margin: 0 auto 4rem;
    padding: 48px 56px;
    background: #fff;
    color: #111;
    box-shadow: 0 2px 24px rgba(0, 0, 0, 0.1);
    border-radius: 4px;
  }

  /* ── Header ── */
  .cv-header {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    margin-bottom: 0;
  }

  .cv-photo {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid #ddd;
  }

  .cv-header-info {
    flex: 1;
  }

  .cv-name {
    font-size: 1.75rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 0.2rem;
    line-height: 1.2;
  }

  .cv-role {
    font-size: 1rem;
    color: #444;
    margin-bottom: 0.2rem;
  }

  .cv-location {
    font-size: 0.88rem;
    color: #666;
    margin-bottom: 0.5rem;
  }

  .cv-contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .cv-contact-link {
    font-size: 0.82rem;
    color: #444;
    text-decoration: none;
  }

  .cv-contact-link:hover {
    color: #111;
  }

  /* ── Divider ── */
  .cv-rule {
    border: none;
    border-top: 1px solid #ddd;
    margin: 1.5rem 0;
  }

  /* ── Sections ── */
  .cv-section {
    margin-bottom: 0;
  }

  .cv-section-title {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 1rem;
  }

  /* ── Work / Cert entries ── */
  .cv-entry,
  .cv-cert-entry {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 0 1.5rem;
    margin-bottom: 1.1rem;
  }

  .cv-entry:last-child,
  .cv-cert-entry:last-child {
    margin-bottom: 0;
  }

  .cv-entry-meta,
  .cv-cert-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-top: 1px;
  }

  .cv-entry-date {
    font-size: 0.78rem;
    color: #555;
    white-space: nowrap;
  }

  .cv-entry-company {
    font-size: 0.8rem;
    color: #444;
    font-weight: 500;
  }

  .cv-entry-role {
    font-size: 0.9rem;
    color: #111;
    display: block;
    margin-bottom: 0.3rem;
  }

  .cv-entry-desc {
    font-size: 0.82rem;
    color: #444;
    line-height: 1.6;
    margin: 0;
  }

  .cv-cert-name {
    font-weight: 600;
    font-size: 0.88rem;
    color: #111;
    text-decoration: none;
  }

  /* ── Skills ── */
  .cv-skills-list {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.15rem 1.5rem;
    font-size: 0.88rem;
    color: #333;
    line-height: 1.6;
    margin: 0;
  }

  .cv-skills-list dt {
    font-weight: 600;
  }

  .cv-skills-list dd {
    margin: 0;
  }

  /* ── Languages ── */
  .cv-lang-grid {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .cv-lang-entry {
    font-size: 0.88rem;
    color: #333;
  }

  /* ── GDPR disclaimer ── */
  .cv-gdpr {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid #e5e5e5;
    font-size: 0.72rem;
    color: #888;
    font-style: italic;
    line-height: 1.5;
  }

  /* ── Mobile: download-only view ── */
  .cv-mobile-msg {
    display: none;
  }

  @media screen and (max-width: 640px) {
    .cv-actions {
      display: none;
    }

    .cv-mobile-msg {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
      padding: 4rem 1.5rem;
      text-align: center;
    }

    .cv-mobile-msg p {
      color: var(--muted);
      font-size: 0.9rem;
      max-width: 32ch;
      line-height: 1.6;
    }

    .cv-page {
      display: none;
    }
  }

  /* ── Print ── */
  @media print {
    .cv-actions {
      display: none !important;
    }

    .cv-page {
      max-width: 100%;
      margin: 0;
      padding: 0;
      box-shadow: none;
      border-radius: 0;
      background: #fff !important;
      color: #000 !important;
    }

    @page {
      size: A4 portrait;
      margin: 15mm 20mm;
    }

    .cv-name,
    .cv-role,
    .cv-location,
    .cv-section-title,
    .cv-entry-role,
    .cv-entry-company,
    .cv-entry-desc,
    .cv-skills-list,
    .cv-lang-entry {
      color: #000 !important;
    }

    .cv-entry-date,
    .cv-location {
      color: #444 !important;
    }

    .cv-contact-link,
    .cv-cert-name {
      color: #000 !important;
      text-decoration: none !important;
    }

    .cv-rule {
      border-color: #bbb !important;
    }

    .cv-photo {
      border-color: #ccc !important;
    }

    .cv-entry,
    .cv-cert-entry {
      break-inside: avoid;
    }

    .cv-section {
      break-inside: avoid;
    }
  }
</style>
