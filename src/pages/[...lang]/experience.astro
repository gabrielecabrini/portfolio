---
import ExternalArrow from '../../components/ExternalArrow.astro';
import Base from '../../layouts/Base.astro';
import CtaRow from '../../components/CtaRow.astro';
import { CERTIFICATIONS, LANGUAGES, SKILL_GROUPS, WORK_EXPERIENCES } from '../../data/experience';
import { langPaths, localePath, pageLang, t } from '../../i18n';
import { dateRange, duration, formatMonthYear, workPlace } from '../../lib/format';

export const getStaticPaths = langPaths;
const lang = pageLang(Astro.params.lang);
---

<Base
  lang={lang}
  title={t(lang, 'title.experience')}
  description={t(lang, 'experience.seo.description')}
>
  <section class="page sections">
    <h1 class="sr-only">{t(lang, 'title.experience')}</h1>
    <!-- Work Experience: declaration order (unlike /cv, which re-sorts by end date) -->
    <div class="exp-section">
      <h2>{t(lang, 'experience.work.title')}</h2>

      <div class="timeline">
        {WORK_EXPERIENCES.map((job) => (
          <div class="timeline-item">
            <img class="logo" src={job.logoUrl} alt={job.company} decoding="async" loading="lazy" />
            <div class="item-body">
              <div class="item-header">
                <div>
                  <h3 class="item-title">{t(lang, job.roleKey)}</h3>
                  <span class="item-subtitle">
                    {[job.company, workPlace(job, lang)].filter(Boolean).join(' · ')}
                  </span>
                </div>
                <div class="item-when">
                  <span class="item-date">{dateRange(job.startDate, job.endDate, lang)}</span>
                  <span class="item-duration" data-start={job.endDate ? undefined : job.startDate}>
                    {duration(job.startDate, job.endDate, lang)}
                  </span>
                </div>
              </div>
              <p class="item-desc">{t(lang, job.descriptionKey)}</p>
            </div>
          </div>
        ))}
      </div>

      <a class="projects-link" href={localePath(lang, '/projects')}>
        {t(lang, 'experience.projects.link')} <span aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Skills -->
    <div class="exp-section">
      <h2>{t(lang, 'experience.skills.title')}</h2>

      <div class="skill-groups">
        {SKILL_GROUPS.map((group) => (
          <div class="skill-group">
            <h3 class="skill-cat-label">{t(lang, group.categoryKey)}</h3>
            <ul class="skill-chips">
              {group.skills.map((skill) => (
                <li class="skill-chip">
                  <img
                    class="skill-chip-icon"
                    src={skill.iconUrl}
                    alt=""
                    decoding="async"
                    loading="lazy"
                  />
                  {skill.name}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Languages -->
    <div class="exp-section">
      <h2>{t(lang, 'experience.languages.title')}</h2>

      <ul class="lang-list">
        {LANGUAGES.map((language) => (
          <li>
            <img class="lang-flag" src={language.iconUrl} alt="" decoding="async" loading="lazy" />
            <span class="lang-name">{t(lang, language.nameKey)}</span>
            <span class="lang-level">{t(lang, language.levelKey)}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Certifications -->
    <div class="exp-section">
      <h2>{t(lang, 'experience.certs.title')}</h2>

      <div>
        {CERTIFICATIONS.map((cert) => (
          <div class="cert">
            <img
              class="logo"
              src={cert.iconUrl}
              alt={cert.issuer}
              decoding="async"
              loading="lazy"
            />
            <div class="cert-body">
              <h3 class="cert-name">
                {cert.url ? (
                  <a href={cert.url} target="_blank" rel="noopener noreferrer">
                    {cert.name} <ExternalArrow />
                  </a>
                ) : (
                  cert.name
                )}
              </h3>
              <span class="cert-issuer">{cert.issuer}</span>
              <span class="cert-date">{formatMonthYear(cert.date, lang)}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- The section gap already spaces it -->
    <CtaRow lang={lang} style="margin-top: 0" />
  </section>
  <script>
    import { duration } from '../../lib/format';

    // Ongoing roles: swap the build-time duration for one measured today.
    const lang = document.documentElement.lang === 'en' ? 'en' : 'it';
    document.querySelectorAll<HTMLElement>('[data-start]').forEach((el) => {
      el.textContent = duration(el.dataset['start']!, undefined, lang);
    });
  </script>
</Base>

<style>
  .sections {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .exp-section > h2 {
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .projects-link {
    display: inline-block;
    /* Bigger tap area, same layout */
    padding-block: 0.6rem;
    margin-block: -0.6rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .projects-link:hover {
    color: var(--accent);
  }

  /* ── Timeline (Work Experience) ── */

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .timeline-item {
    display: flex;
    gap: 1.25rem;
    padding-bottom: 2rem;
    position: relative;
    --logo: 46px;
  }

  .timeline-item:not(:last-child)::before {
    content: '';
    position: absolute;
    /* Centred under the logo, starting just below it */
    left: calc(var(--logo) / 2);
    top: calc(var(--logo) + 4px);
    bottom: 0;
    width: 1px;
    background: var(--border);
  }

  /* Company and issuer logos: sized by --logo on the row */
  .logo {
    width: var(--logo);
    height: var(--logo);
    flex-shrink: 0;
    object-fit: contain;
  }

  .timeline-item .logo {
    border-radius: var(--radius);
  }

  .item-body {
    flex: 1;
    padding-top: 0.1rem;
    /* prevent long words (company names) from overflowing */
    min-width: 0;
  }

  .item-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.6rem;
    flex-wrap: wrap;
  }

  .item-title {
    font-size: 1rem;
    margin-bottom: 0.2rem;
  }

  .item-subtitle {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .item-when {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
  }

  .item-date {
    color: var(--muted);
    font-size: 0.82rem;
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .item-duration {
    color: var(--muted);
    font-size: 0.75rem;
    font-family: var(--font-mono);
    opacity: 0.8;
  }

  .item-desc {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* ── Skills ── */

  .skill-groups {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* One row per category: label on the left, skills wrapping on the right */
  .skill-group {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1.5rem;
    font-size: 0.9rem;
  }

  .skill-cat-label {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
    /* As tall as a line of skills, so the label centres on the first one */
    line-height: 1lh;
  }

  .skill-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .skill-chip-icon {
    width: 16px;
    height: 16px;
    object-fit: contain;
  }

  /* ── Languages ── */

  .lang-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
  }

  .lang-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
  }

  .lang-flag {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .lang-name {
    font-weight: 500;
  }

  .lang-level {
    color: var(--muted);
  }

  /* ── Certifications ── */

  .cert {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    --logo: 56px;
  }

  .cert + .cert {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .cert-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .cert-name {
    font-size: 0.95rem;
    color: var(--text);
    font-weight: 500;
  }

  .cert-name a {
    color: var(--text);
  }

  .cert-name a:hover {
    color: var(--accent);
  }

  .cert-issuer {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .cert-date {
    color: var(--muted);
    font-size: 0.8rem;
    font-family: var(--font-mono);
  }

  /* ── Responsive ── */

  @media (max-width: 768px) {
    .sections {
      gap: 2.5rem;
    }

    .item-header {
      flex-direction: column;
      gap: 0.25rem;
    }

    .item-when {
      align-items: flex-start;
    }
  }

  @media (max-width: 480px) {
    .skill-group {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
