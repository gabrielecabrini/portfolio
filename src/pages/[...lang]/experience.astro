---
import Base from '../../layouts/Base.astro';
import { CERTIFICATIONS, LANGUAGES, SKILL_GROUPS, WORK_EXPERIENCES } from '../../data/experience';
import { langPaths, localePath, pageLang, t } from '../../i18n';
import { dateRange, formatMonthYear, workPlace } from '../../lib/format';

export const getStaticPaths = langPaths;
const lang = pageLang(Astro.params.lang);
---

<Base
  lang={lang}
  title={t(lang, 'title.experience')}
  description={t(lang, 'experience.seo.description')}
>
  <section class="exp-page">
    <div class="exp-inner">
      <h1 class="sr-only">{t(lang, 'title.experience')}</h1>
      <!-- Work Experience: declaration order (unlike /cv, which re-sorts by end date) -->
      <div class="exp-section">
        <h2>{t(lang, 'experience.work.title')}</h2>

        {WORK_EXPERIENCES.length === 0 && <p class="empty">{t(lang, 'experience.empty')}</p>}

        <div class="timeline">
          {WORK_EXPERIENCES.map((job) => (
            <div class="timeline-item">
              {job.logoUrl ? (
                <div class="item-logo">
                  <img src={job.logoUrl} alt={job.company} decoding="async" loading="lazy" />
                </div>
              ) : (
                <div class="item-logo placeholder">{job.company.charAt(0)}</div>
              )}
              <div class="item-body">
                <div class="item-header">
                  <div>
                    <h3 class="item-title">{t(lang, job.roleKey)}</h3>
                    <span class="item-subtitle">
                      {[job.company, workPlace(job, lang)].filter(Boolean).join(' · ')}
                    </span>
                  </div>
                  <span class="item-date">{dateRange(job.startDate, job.endDate, lang)}</span>
                </div>
                <p class="item-desc">{t(lang, job.descriptionKey)}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Skills -->
      <div class="exp-section">
        <h2>{t(lang, 'experience.skills.title')}</h2>

        <div class="skill-groups">
          {SKILL_GROUPS.map((group) => (
            <div class="skill-group">
              <h3 class="skill-cat-label">{t(lang, group.categoryKey)}</h3>
              <ul class="skill-chips">
                {group.skills.map((skill) => (
                  <li class="skill-chip">
                    {skill.iconUrl && (
                      <img
                        class="skill-chip-icon"
                        src={skill.iconUrl}
                        alt=""
                        decoding="async"
                        loading="lazy"
                      />
                    )}
                    {skill.name}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- Languages -->
      <div class="exp-section">
        <h2>{t(lang, 'experience.languages.title')}</h2>

        <div class="skills-grid">
          {LANGUAGES.map((language) => (
            <div class="skill-card">
              <img
                class="skill-icon"
                src={language.iconUrl}
                alt={t(lang, language.nameKey)}
                decoding="async"
                loading="lazy"
              />
              <div class="skill-body">
                <h3>{t(lang, language.nameKey)}</h3>
                <p>{t(lang, language.levelKey)}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Certifications -->
      <div class="exp-section">
        <h2>{t(lang, 'experience.certs.title')}</h2>

        {CERTIFICATIONS.length === 0 && <p class="empty">{t(lang, 'experience.empty')}</p>}

        <div class="certs-grid">
          {CERTIFICATIONS.map((cert) => (
            <div class="cert-card">
              {cert.iconUrl ? (
                <div class="cert-logo">
                  <img src={cert.iconUrl} alt={cert.issuer} decoding="async" loading="lazy" />
                </div>
              ) : (
                <div class="cert-logo placeholder">{cert.issuer.charAt(0)}</div>
              )}
              <div class="cert-body">
                <h3 class="cert-name">
                  {cert.url ? (
                    <a href={cert.url} target="_blank" rel="noopener noreferrer">
                      {cert.name} ↗
                    </a>
                  ) : (
                    cert.name
                  )}
                </h3>
                <span class="cert-issuer">{cert.issuer}</span>
                <span class="cert-date">{formatMonthYear(cert.date, lang)}</span>
                {cert.credentialId && (
                  <span class="cert-date">
                    {t(lang, 'experience.certs.credentialId')}: {cert.credentialId}
                  </span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="exp-cta">
        <a href={localePath(lang, '/projects')} class="btn-primary">
          {t(lang, 'experience.cta.projects')}
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .exp-page {
    padding: 5rem 1.5rem;
  }

  .exp-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .exp-section > h2 {
    color: var(--text);
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .empty {
    color: var(--muted);
    font-size: 0.95rem;
  }

  /* ── Timeline (Work Experience) ── */

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .timeline-item {
    display: flex;
    gap: 1.25rem;
    padding-bottom: 2rem;
    position: relative;
  }

  .timeline-item:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 23px;
    top: 50px;
    bottom: 0;
    width: 1px;
    background: var(--border);
  }

  .item-logo {
    width: 46px;
    height: 46px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
  }

  .item-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .item-logo.placeholder {
    color: var(--accent);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .item-body {
    flex: 1;
    padding-top: 0.1rem;
    /* prevent long words (company names) from overflowing */
    min-width: 0;
  }

  .item-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.6rem;
    flex-wrap: wrap;
  }

  .item-title {
    color: var(--text);
    font-size: 1rem;
    margin-bottom: 0.2rem;
  }

  .item-subtitle {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .item-subtitle a {
    color: var(--muted);
  }

  .item-subtitle a:hover {
    color: var(--accent);
  }

  .item-date {
    color: var(--muted);
    font-size: 0.82rem;
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .item-desc {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* ── Skills ── */

  .skill-groups {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* One row per category: label on the left, chips wrapping on the right */
  .skill-group {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .skill-cat-label {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
    /* Centre on the first row of chips */
    line-height: 2.2rem;
  }

  .skill-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.2rem;
    padding: 0 0.8rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 0.875rem;
    font-weight: 500;
    transition: border-color 0.15s;
  }

  .skill-chip:hover {
    border-color: var(--accent);
  }

  .skill-chip-icon {
    width: 18px;
    height: 18px;
    object-fit: contain;
  }

  .skills-grid {
    display: grid;
    /* 4 per row at full page width, fewer as it narrows */
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 0.75rem;
  }

  .skill-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.9rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transition: border-color 0.15s;
  }

  .skill-card:hover {
    border-color: var(--accent);
  }

  .skill-icon {
    width: 32px;
    height: 32px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .skill-body h3 {
    color: var(--text);
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }

  .skill-body p {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  /* ── Certifications ── */

  .certs-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cert-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    transition: border-color 0.15s;
  }

  .cert-card:hover {
    border-color: var(--accent);
  }

  .cert-logo {
    width: 46px;
    height: 46px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-hover);
  }

  .cert-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 4px;
  }

  .cert-logo.placeholder {
    color: var(--accent);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .cert-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .cert-name {
    font-size: 0.95rem;
    color: var(--text);
    font-weight: 500;
  }

  .cert-name a {
    color: var(--text);
  }

  .cert-name a:hover {
    color: var(--accent);
  }

  .cert-issuer {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .cert-date {
    color: var(--muted);
    font-size: 0.8rem;
    font-family: var(--font-mono);
  }

  .exp-cta {
    text-align: center;
  }

  /* ── Responsive ── */

  @media (max-width: 768px) {
    .exp-page {
      padding: 3rem 1rem;
    }

    .exp-inner {
      gap: 2.5rem;
    }

    .item-header {
      flex-direction: column;
      gap: 0.25rem;
    }

    .skills-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    }
  }

  @media (max-width: 480px) {
    .exp-page {
      padding: 2rem 1rem;
    }

    .skill-group {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .skill-cat-label {
      line-height: normal;
    }

    /* Compact icon-grid: 3 columns, icon above name */
    .skills-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.6rem;
    }

    .skill-card {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0.75rem 0.4rem;
      gap: 0.45rem;
    }

    .skill-body h3 {
      font-size: 0.75rem;
      margin-bottom: 0;
    }

    /* description only shown for languages, not skills — keep it small */
    .skill-body p {
      font-size: 0.72rem;
    }
  }
</style>
