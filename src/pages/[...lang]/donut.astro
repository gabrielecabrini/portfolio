---
import Base from '../../layouts/Base.astro';
import { langPaths, pageLang } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = pageLang(Astro.params.lang);
---

<Base lang={lang} title="Donut">
  <section class="donut-page">
    <pre id="donut" role="img" aria-label="Spinning ASCII donut"></pre>
  </section>
  <script>
    // a1k0n's donut, optimised: an 80×22 frame, z-buffered, lit by luminance.
    // sin/cos only once per frame; θ and φ advance by rotating their (cos, sin) pairs a fixed step.
    const pre = document.getElementById('donut')!;
    // Steps per ring (θ around the tube, φ around the axis); each step is 2π / count so the rings close exactly.
    const NJ = 90,
      NI = 315;
    const cDJ = Math.cos((2 * Math.PI) / NJ),
      sDJ = Math.sin((2 * Math.PI) / NJ),
      cDI = Math.cos((2 * Math.PI) / NI),
      sDI = Math.sin((2 * Math.PI) / NI);
    const b: string[] = [];
    const z = new Float32Array(1760);

    function frame(A: number, B: number) {
      const cA = Math.cos(A),
        sA = Math.sin(A),
        cB = Math.cos(B),
        sB = Math.sin(B);
      for (let k = 0; k < 1760; k++) b[k] = k % 80 === 79 ? '\n' : ' ';
      z.fill(0);
      let ct = 1,
        st = 0;
      for (let j = 0; j < NJ; j++) {
        const h = ct + 2,
          stsA = st * sA,
          stcA = st * cA;
        let cp = 1,
          sp = 0;
        for (let i = 0; i < NI; i++) {
          const D = 1 / (sp * h * sA + stcA + 5),
            t = sp * h * cA - stsA,
            x = Math.floor(40 + 30 * D * (cp * h * cB - t * sB)),
            y = Math.floor(12 + 15 * D * (cp * h * sB + t * cB)),
            o = x + 80 * y,
            N = (8 * ((stsA - sp * ct * cA) * cB - sp * ct * sA - stcA - cp * ct * sB)) | 0;
          if (y >= 0 && y < 22 && x >= 0 && x < 79 && D > z[o]!) {
            z[o] = D;
            b[o] = '.,-~:;=!*#$@'[N > 0 ? N : 0]!;
          }
          const c = cp;
          cp = c * cDI - sp * sDI;
          sp = sp * cDI + c * sDI;
        }
        const c = ct;
        ct = c * cDJ - st * sDJ;
        st = st * cDJ + c * sDJ;
      }
      pre.textContent = b.join('');
    }

    // Angles from the timestamp, not per-frame steps, so 144 Hz screens don't spin faster
    function loop(time: number) {
      frame(time / 1000, time / 2000);
      requestAnimationFrame(loop);
    }

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) frame(1, 0.5);
    else requestAnimationFrame(loop);
  </script>
</Base>

<style>
  .donut-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--header-h) - var(--footer-h));
    padding: 2rem 1rem;
  }

  #donut {
    color: var(--accent);
    font-family: var(--font-mono);
    /* 80 columns of ~0.6em must fit the viewport, so the size follows its width */
    font-size: min(0.9rem, 1.8vw);
    line-height: 1.1;
  }
</style>
