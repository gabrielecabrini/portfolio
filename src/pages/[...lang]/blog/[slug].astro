---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { formatDay } from '../../../lib/format';
import { getPosts, isTranslated, pick } from '../../../lib/blog';
import { langPaths, localePath, pageLang, t } from '../../../i18n';

// Every post under both interface languages, translated or not: /blog/x/ and /en/blog/x/
export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return langPaths().flatMap(({ params }) =>
    posts.map((post) => ({ params: { ...params, slug: post.slug }, props: { post } })),
  );
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const lang = pageLang(Astro.params.lang);
const { entry, lang: postLang } = pick(post, lang);
const { Content } = await render(entry);
// Only real translations are hreflang twins; otherwise both pages point at the original
const canonicalLang = isTranslated(post) ? undefined : postLang;
---

<Base
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  canonicalLang={canonicalLang}
>
  <article class="post" lang={postLang}>
    <header class="enter">
      <a class="back" lang={lang} href={localePath(lang, '/blog')}>
        ← Blog
      </a>
      <h1>{entry.data.title}</h1>
      <time lang={lang} datetime={entry.data.pubDate.toISOString()}>
        {formatDay(entry.data.pubDate, lang)}
      </time>
      {postLang !== lang && (
        <p class="untranslated" lang={lang}>
          {t(lang, 'blog.untranslated')}
        </p>
      )}
    </header>
    <div class="prose enter" style="--i: 1">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post {
    max-width: 70ch;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }

  header {
    margin-bottom: 2.5rem;
  }

  .back {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .back:hover {
    color: var(--accent);
  }

  h1 {
    color: var(--text);
    margin: 0.75rem 0 0.5rem;
  }

  .untranslated {
    margin-top: 1.25rem;
    padding: 0.6rem 0.9rem;
    border-left: 2px solid var(--accent);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.9rem;
  }

  time {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* Markdown output has no classes of its own: style it by element */
  .prose :global(> * + *) {
    margin-top: 1.1em;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin-top: 2em;
  }

  .prose :global(p),
  .prose :global(li) {
    line-height: 1.7;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
  }

  .prose :global(pre) {
    padding: 1rem;
    border-radius: var(--radius);
    overflow-x: auto;
    font-size: 0.85rem;
  }

  /* Shiki colours the block itself; the inline-code chip would box every token */
  .prose :global(pre code) {
    background: none;
    border: 0;
    padding: 0;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .post {
      padding: 3rem 1rem;
    }
  }

  @media (max-width: 480px) {
    .post {
      padding: 2rem 1rem;
    }
  }
</style>
