---
import ExternalArrow from '../../components/ExternalArrow.astro';
import Base from '../../layouts/Base.astro';
import CtaRow from '../../components/CtaRow.astro';
import { PROJECTS } from '../../data/projects';
import { langPaths, pageLang, t } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = pageLang(Astro.params.lang);
---

<Base lang={lang} title={t(lang, 'title.projects')} description={t(lang, 'projects.subtitle')}>
  <section class="page">
    <h1>{t(lang, 'projects.title')}</h1>
    <p class="section-desc">{t(lang, 'projects.subtitle')}</p>

    {PROJECTS.map((project) => {
      const title = t(lang, project.titleKey);
      return (
        <article class="project">
          <img class="project-logo" src={project.imageUrl} alt="" decoding="async" loading="lazy" />
          <div class="project-body">
            <div class="project-head">
              <h2>
                <a href={project.url} target="_blank" rel="noopener noreferrer">
                  {title}
                </a>
              </h2>
              <div class="project-links">
                <a href={project.url} target="_blank" rel="noopener noreferrer">
                  {t(lang, 'projects.card.site')} <span class="sr-only">{title}</span>{' '}
                  <ExternalArrow />
                </a>
                {project.repoUrl && (
                  <a href={project.repoUrl} target="_blank" rel="noopener noreferrer">
                    GitHub <span class="sr-only">{title}</span> <ExternalArrow />
                  </a>
                )}
              </div>
            </div>
            <p>{t(lang, project.descriptionKey)}</p>
            <p class="tags">{project.tags.join(' · ')}</p>
          </div>
        </article>
      );
    })}

    <CtaRow lang={lang} />
  </section>
</Base>

<style>
  h1 {
    margin-bottom: 0.5rem;
  }

  .section-desc {
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  /* One project per row, ruled off from the next */
  .project {
    display: flex;
    gap: 1rem;
    padding-block: 1rem;
    border-top: 1px solid var(--border);
  }

  .project-logo {
    width: 32px;
    height: 32px;
    object-fit: contain;
    flex-shrink: 0;
    border-radius: 4px;
    /* Hairline rim along the logo's own shape: a black mark stays readable on the dark page */
    filter: drop-shadow(0 0 0.5px color-mix(in srgb, var(--text) 45%, transparent));
  }

  .project-body {
    flex: 1;
    min-width: 0;
  }

  /* Title on the left, its links on the right; the links wrap below on narrow screens */
  .project-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 1rem;
    margin-bottom: 0.15rem;
  }

  h2 {
    font-size: 1.05rem;
  }

  h2 a {
    color: var(--text);
  }

  h2 a:hover {
    color: var(--accent);
  }

  .project-body p {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.55;
    max-width: 75ch;
  }

  .project-body .tags {
    margin-top: 0.3rem;
    font-size: 0.75rem;
    font-family: var(--font-mono);
  }

  .project-links {
    display: flex;
    gap: 1rem;
    font-size: 0.85rem;
  }

  .project-links a {
    /* Bigger tap area, same layout */
    padding-block: 0.4rem;
    margin-block: -0.4rem;
  }

  /* ── Responsive ── */
</style>
