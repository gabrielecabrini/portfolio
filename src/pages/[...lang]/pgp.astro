---
import ExternalArrow from '../../components/ExternalArrow.astro';
import Base from '../../layouts/Base.astro';
import { PGP_KEY } from '../../data/pgp';
import { EMAIL } from '../../data/social-links';
import { langPaths, pageLang } from '../../i18n';
import { formatFingerprint } from '../../lib/format';

export const getStaticPaths = langPaths;
const lang = pageLang(Astro.params.lang);

const { fingerprint, uids, keys } = PGP_KEY;
const [primary, ...subkeys] = keys;
const keyUrl = new URL('/gabrielecabrini.asc', Astro.site).href;
const [firstHalf, secondHalf] = formatFingerprint(fingerprint);
// Same columns as `gpg --fingerprint`: a 6-char record type, then the key itself.
const keyLine = (key: (typeof keys)[number]) =>
  `${key.kind.padEnd(6)}${key.algorithm} ${key.created} [${key.usage}] [expires: ${key.expires}]`;
---

<!-- English in both locales, like the gpg output it shows -->
<Base
  lang={lang}
  title="PGP"
  description="Gabriele Cabrini's PGP public key: fingerprint, download and commands to import it."
>
  <section class="pgp-page">
    <div class="pgp-inner">
      <h1>PGP</h1>

      <pre class="term"><span class="prompt">$</span> gpg --fingerprint {EMAIL.name}
{keyLine(primary!)}
      <span class="fpr">{firstHalf}<span class="fpr-gap" />{secondHalf}</span> <button class="copy" type="button" hidden lang="en" aria-label="Copy fingerprint" data-fingerprint={fingerprint}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" /></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" /></svg></button>
{uids.map((uid) => `${'uid'.padEnd(6)}${uid}\n`)}{subkeys.map((key) => `${keyLine(key)}\n`)}
<span class="prompt">$</span> curl -sL {keyUrl} | gpg --import
<span class="prompt">$</span> gpg --locate-keys {EMAIL.name}
<span class="prompt">$</span> gpg --keyserver keys.openpgp.org --recv-keys {fingerprint}</pre>

      <div class="pgp-links">
        <a href="/gabrielecabrini.asc" download data-astro-prefetch="false">
          gabrielecabrini.asc <span aria-hidden="true">↓</span>
        </a>
        <a
          href={`https://keys.openpgp.org/search?q=${fingerprint}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          keys.openpgp.org <ExternalArrow />
        </a>
      </div>
    </div>
  </section>
  <script>
    // Hidden without the Clipboard API: the fingerprint can still be selected by hand.
    const copy = document.querySelector<HTMLButtonElement>('.copy');
    if (copy && navigator.clipboard) {
      copy.hidden = false;
      copy.addEventListener('click', async () => {
        await navigator.clipboard.writeText(copy.dataset['fingerprint']!);
        copy.classList.add('copied');
        setTimeout(() => copy.classList.remove('copied'), 1500);
      });
    }
  </script>
</Base>

<style>
  .pgp-page {
    padding: 5rem var(--gutter);
  }

  .pgp-inner {
    max-width: var(--max-w);
    margin: 0 auto;
  }

  h1 {
    color: var(--text);
    margin-bottom: 2rem;
  }

  /* Terminal output: one mono size, long lines scroll instead of wrapping like a real tty */
  .term {
    margin: 0 0 2rem;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.7;
    overflow-x: auto;
  }

  .prompt {
    color: var(--accent);
    font-weight: 700;
    user-select: none;
  }

  .fpr {
    color: var(--text);
    font-weight: 500;
  }

  /* Generated, so a hand-selected fingerprint copies without the gap */
  .fpr-gap::before {
    content: '  ';
  }

  .copy {
    background: none;
    border: none;
    /* Bigger tap area, same line height */
    padding: 0.4em;
    margin: -0.4em 0;
    color: var(--muted);
    vertical-align: middle;
  }

  .copy:hover,
  .copy.copied {
    color: var(--accent);
  }

  .copy svg {
    width: 1.1em;
    height: 1.1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Two icons, one shown: the tick replaces the sheets for a moment after copying */
  .copy:not(.copied) svg:last-child,
  .copy.copied svg:first-child {
    display: none;
  }

  .pgp-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .pgp-page {
      padding: 3rem var(--gutter);
    }
  }

  @media (max-width: 480px) {
    .pgp-page {
      padding: 2rem var(--gutter);
    }

    .term {
      padding: 1rem;
      font-size: 0.75rem;
    }

    /* The fingerprint must be readable without scrolling: second half on its own line */
    .fpr-gap::before {
      content: '\A';
    }

    /* Indent as a 6ch box, not spaces: the minifier turns '\A ' into an escape that eats one */
    .fpr-gap::after {
      content: '';
      display: inline-block;
      width: 6ch;
    }
  }
</style>
