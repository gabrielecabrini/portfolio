---
import Base from '../../layouts/Base.astro';
import { EMAIL } from '../../data/social-links';
import { langPaths, pageLang, t } from '../../i18n';
import { cvPdfHref } from '../../lib/cv';
import HeadModel from '../../components/HeadModel.astro';

export const getStaticPaths = langPaths;
const lang = pageLang(Astro.params.lang);
---

<Base lang={lang} description={t(lang, 'home.seo.description')}>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-left">
        <div class="intro">
          <p class="enter label" style="--i: 0">
            {t(lang, 'home.greeting')}
          </p>
          <h1 class="enter" style="--i: 1">
            Gabriele Cabrini
          </h1>
          <p class="enter subtitle" style="--i: 2">
            {t(lang, 'home.subtitle')}
          </p>
        </div>
        <p class="enter tagline" style="--i: 3">
          {t(lang, 'home.tagline')}
        </p>
        <div class="enter cta-row" style="--i: 4">
          <a href={cvPdfHref(lang)} download data-astro-prefetch="false" class="btn-primary">
            {t(lang, 'cta.cv')}
          </a>
          <a href={EMAIL.href} class="btn-secondary">
            {t(lang, 'cta.contact')}
          </a>
        </div>

        <p class="enter availability" style="--i: 5">
          <span class="avail-dot" aria-hidden="true"></span>
          {t(lang, 'home.available')}
        </p>
      </div>

      <div class="hero-right">
        <HeadModel />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    align-items: center;
    /* dvh accounts for mobile browser chrome (address bar) */
    min-height: calc(100dvh - var(--header-h) - var(--footer-h));
    min-height: calc(100vh - var(--header-h) - var(--footer-h)); /* fallback */
    padding: 4rem var(--gutter);
  }

  .hero-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4rem;
  }

  .hero-right {
    flex-shrink: 0;
  }

  .label {
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 500;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-size: clamp(1rem, 2.5vw, 1.3rem);
    color: var(--muted);
    font-weight: 400;
    margin-bottom: 1rem;
    max-width: none;
    min-height: 1.6em;
  }

  .tagline {
    color: var(--muted);
    font-size: 1rem;
    max-width: 55ch;
    margin-bottom: 2.5rem;
  }

  .cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .availability {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    max-width: none;
    margin-top: 1rem;
  }

  .avail-dot {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    /* Centered on the first line, not on the whole block, when the text wraps */
    margin-top: calc((1lh - 8px) / 2);
    position: relative;
    border-radius: 50%;
    background: #22c55e;
  }

  .avail-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    animation: avail-pulse 1.8s ease-out infinite;
  }

  @media (max-width: 700px) {
    /* Small head beside the intro (label, name, subtitle); the rest spans the full width.
       display: contents lets the hero-left blocks join the grid directly */
    .hero-inner {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0 1rem;
    }

    .hero-left {
      display: contents;
    }

    .tagline,
    .cta-row,
    .availability {
      grid-column: 1 / -1;
    }

    .hero-right {
      grid-column: 2;
      grid-row: 1;
      --head-size: 112px;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: 2.5rem var(--gutter);
      /* on small screens don't force full-viewport height */
      min-height: unset;
    }

    .btn-primary,
    .btn-secondary {
      /* full-width buttons on narrow screens */
      width: 100%;
      text-align: center;
    }
  }
</style>
