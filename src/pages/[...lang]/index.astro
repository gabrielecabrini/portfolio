---
import Base from '../../layouts/Base.astro';
import { EMAIL } from '../../data/social-links';
import { langPaths, pageLang, t } from '../../i18n';
import { cvPdfHref } from '../../lib/cv';
import HeadModel from '../../components/HeadModel.astro';

export const getStaticPaths = langPaths;
const lang = pageLang(Astro.params.lang);
---

<Base lang={lang} description={t(lang, 'home.seo.description')}>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-left">
        <div class="intro">
          <p class="label">{t(lang, 'home.greeting')}</p>
          <h1>Gabriele Cabrini</h1>
          <p class="subtitle">{t(lang, 'home.subtitle')}</p>
        </div>
        <p class="tagline">{t(lang, 'home.tagline')}</p>
        <div class="cta-row">
          <a href={cvPdfHref(lang)} download data-astro-prefetch="false" class="btn-primary">
            {t(lang, 'cta.cv')}
          </a>
          <a href={EMAIL.href} class="btn-secondary">
            {t(lang, 'cta.contact')}
          </a>
        </div>
      </div>

      <div class="hero-right">
        <HeadModel />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    align-items: center;
    /* dvh accounts for mobile browser chrome (address bar) */
    min-height: calc(100dvh - var(--header-h) - var(--footer-h));
    min-height: calc(100vh - var(--header-h) - var(--footer-h)); /* fallback */
    padding: 4rem var(--gutter);
  }

  .hero-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4rem;
  }

  .hero-right {
    flex-shrink: 0;
  }

  .label {
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 500;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-size: clamp(1rem, 2.5vw, 1.3rem);
    color: var(--muted);
    font-weight: 400;
    margin-bottom: 1rem;
    max-width: none;
    min-height: 1.6em;
  }

  .tagline {
    color: var(--muted);
    font-size: 1rem;
    max-width: 55ch;
    margin-bottom: 2.5rem;
  }

  .cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 700px) {
    /* Small head beside the intro (label, name, subtitle); the rest spans the full width.
       display: contents lets the hero-left blocks join the grid directly */
    .hero-inner {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0 1rem;
    }

    .hero-left {
      display: contents;
    }

    .tagline,
    .cta-row {
      grid-column: 1 / -1;
    }

    .hero-right {
      grid-column: 2;
      grid-row: 1;
      --head-size: 112px;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: 2.5rem var(--gutter);
      /* on small screens don't force full-viewport height */
      min-height: unset;
    }

    .btn-primary,
    .btn-secondary {
      /* full-width buttons on narrow screens */
      width: 100%;
      text-align: center;
    }
  }
</style>
