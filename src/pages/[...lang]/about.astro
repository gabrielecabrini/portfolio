---
import Base from '../../layouts/Base.astro';
import CtaRow from '../../components/CtaRow.astro';
import { PGP_LINK, SOCIAL_LINKS } from '../../data/social-links';
import { langPaths, localePath, pageLang, t } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = pageLang(Astro.params.lang);
const links = [...SOCIAL_LINKS, { ...PGP_LINK, href: localePath(lang, PGP_LINK.href) }];
---

<Base lang={lang} title={t(lang, 'title.about')} description={t(lang, 'about.seo.description')}>
  <section class="about-page">
    <div class="about-inner">
      <div class="profile-row enter">
        <img class="avatar" src="/assets/images/pfp.jpeg" alt="Gabriele Cabrini" decoding="async" />
        <div>
          <div class="section-header">
            <h1>{t(lang, 'about.title')}</h1>
          </div>
          <div class="bio">
            {t(lang, 'about.bio')
              .split('\n')
              .map((paragraph) => (
                <p>{paragraph}</p>
              ))}
          </div>
          {lang === 'en' && (
            <p class="local-time" hidden>
              Local time in Bergamo: <time>--:--</time>
            </p>
          )}
        </div>
      </div>

      <blockquote class="quote enter" style="--i: 1">
        <p>
          Any fool can write code that a computer can understand. Good programmers write code that
          humans can understand.
        </p>
        <cite>— Martin Fowler</cite>
      </blockquote>

      <div class="section-header links-section-header enter" style="--i: 2">
        <h2>{t(lang, 'about.links.title')}</h2>
      </div>

      <div class="links-grid enter" style="--i: 2">
        {links.map((link) => (
          <a href={link.href} target={link.target} rel={link.rel} class="link-card">
            <span class="link-icon">
              <img src={link.iconUrl} alt="" class="link-img" decoding="async" loading="lazy" />
            </span>
            <span class="link-name">{link.name}</span>
            <span class="link-arrow" aria-hidden="true">
              {link.target ? '↗' : '→'}
            </span>
          </a>
        ))}
      </div>

      <CtaRow lang={lang} class="enter" style="--i: 3" />
    </div>
  </section>
  <script>
    // English page only: tells visitors abroad what time it is here before they write.
    const localTime = document.querySelector<HTMLElement>('.local-time');
    if (localTime) {
      const clock = localTime.querySelector('time')!;
      const format = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Europe/Rome',
        hour: '2-digit',
        minute: '2-digit',
      });
      // Re-armed on each minute boundary, so the clock never lags the real minute
      const tick = () => {
        clock.textContent = format.format(new Date());
        setTimeout(tick, 60_000 - (Date.now() % 60_000));
      };
      tick();
      localTime.hidden = false;
    }
  </script>
</Base>

<style>
  .about-page {
    padding: 5rem 1.5rem;
  }

  .about-inner {
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .profile-row {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: 0;
  }

  .avatar {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border);
    flex-shrink: 0;
  }

  @media (min-width: 769px) {
    .avatar {
      width: 140px;
      height: 140px;
    }
  }

  .section-header {
    margin-bottom: 1rem;
  }

  .section-header h1 {
    color: var(--text);
  }

  /* Subheading keeps the h3 size it was designed at */
  .section-header h2 {
    color: var(--text);
    font-size: 1.15rem;
  }

  .quote {
    margin-top: 3rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--accent);
    color: var(--muted);
    font-style: italic;
  }

  .quote cite {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-style: normal;
  }

  .links-section-header {
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .bio {
    margin-bottom: 0;
  }

  .bio p {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .local-time {
    margin-top: 1rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }

  .bio p + p {
    margin-top: 1rem;
  }

  .links-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .link-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    transition:
      border-color 0.15s,
      background 0.15s;
    /* min touch target height */
    min-height: 52px;
  }

  .link-card:hover {
    border-color: var(--accent);
    background: var(--surface-hover);
    color: var(--text);
  }

  .link-icon {
    color: var(--muted);
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }

  .link-card:hover .link-icon {
    color: var(--accent);
  }

  .link-card:hover .link-arrow {
    transform: translateX(3px);
  }

  .link-img {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }

  .link-name {
    font-weight: 500;
    font-size: 0.95rem;
    flex: 1;
    /* prevent long email from overflowing */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .link-arrow {
    color: var(--muted);
    font-size: 0.9rem;
    transition: transform 0.2s ease;
  }

  @media (max-width: 768px) {
    .about-page {
      padding: 3rem 1rem;
    }

    .profile-row {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .bio p {
      text-align: left;
    }

    .links-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .about-page {
      padding: 2rem 1rem;
    }
  }
</style>
