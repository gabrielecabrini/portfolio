---
import ExternalArrow from '../../components/ExternalArrow.astro';
import Base from '../../layouts/Base.astro';
import CtaRow from '../../components/CtaRow.astro';
import { SOCIAL_LINKS } from '../../data/social-links';
import { langPaths, pageLang, t } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = pageLang(Astro.params.lang);
---

<Base lang={lang} title={t(lang, 'title.about')} description={t(lang, 'about.seo.description')}>
  <section class="page">
    <div class="profile-row">
      <img class="avatar" src="/assets/images/pfp.jpeg" alt="Gabriele Cabrini" decoding="async" />
      <div>
        <h1>{t(lang, 'about.title')}</h1>
        <div class="bio">
          {t(lang, 'about.bio')
            .split('\n')
            .map((paragraph) => (
              <p>{paragraph}</p>
            ))}
        </div>
        {lang === 'en' && (
          <p class="local-time" hidden>
            Local time in Bergamo: <time>--:--</time>
          </p>
        )}
      </div>
    </div>

    <h2>{t(lang, 'about.links.title')}</h2>

    <ul class="links">
      {SOCIAL_LINKS.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            <img src={link.iconUrl} alt="" class="link-img" decoding="async" loading="lazy" />
            {link.name}
            <ExternalArrow />
          </a>
        </li>
      ))}
    </ul>

    <CtaRow lang={lang} />
  </section>
  <script>
    // English page only: tells visitors abroad what time it is here before they write.
    const localTime = document.querySelector<HTMLElement>('.local-time');
    if (localTime) {
      const clock = localTime.querySelector('time')!;
      const format = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Europe/Rome',
        hour: '2-digit',
        minute: '2-digit',
      });
      // Re-armed on each minute boundary, so the clock never lags the real minute
      const tick = () => {
        clock.textContent = format.format(new Date());
        setTimeout(tick, 60_000 - (Date.now() % 60_000));
      };
      tick();
      localTime.hidden = false;
    }
  </script>
</Base>

<style>
  .profile-row {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
  }

  .avatar {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border);
    flex-shrink: 0;
  }

  @media (min-width: 769px) {
    .avatar {
      width: 140px;
      height: 140px;
    }
  }

  h1 {
    margin-bottom: 1rem;
  }

  /* Subheading keeps the h3 size it was designed at; ruled like the /experience sections */
  h2 {
    margin: 3rem 0 1.5rem;
    font-size: 1.15rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .bio p {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .local-time {
    margin-top: 1rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }

  .bio p + p {
    margin-top: 1rem;
  }

  /* One line of profiles, wrapping where the screen is narrow */
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2rem;
  }

  .links a {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    /* Tall enough to tap */
    padding-block: 0.6rem;
    color: var(--text);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .links a:hover {
    color: var(--accent);
  }

  .link-img {
    width: 20px;
    height: 20px;
    object-fit: contain;
    flex-shrink: 0;
    margin-right: 0.35rem;
  }

  @media (max-width: 768px) {
    .profile-row {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .bio p {
      text-align: left;
    }
  }
</style>
