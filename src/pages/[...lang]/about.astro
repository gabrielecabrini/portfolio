---
import ExternalArrow from '../../components/ExternalArrow.astro';
import Base from '../../layouts/Base.astro';
import CtaRow from '../../components/CtaRow.astro';
import { SOCIAL_LINKS } from '../../data/social-links';
import { langPaths, pageLang, t } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = pageLang(Astro.params.lang);
---

<Base lang={lang} title={t(lang, 'title.about')} description={t(lang, 'about.seo.description')}>
  <section class="about-page">
    <div class="about-inner">
      <div class="profile-row">
        <img class="avatar" src="/assets/images/pfp.jpeg" alt="Gabriele Cabrini" decoding="async" />
        <div>
          <div class="section-header">
            <h1>{t(lang, 'about.title')}</h1>
          </div>
          <div class="bio">
            {t(lang, 'about.bio')
              .split('\n')
              .map((paragraph) => (
                <p>{paragraph}</p>
              ))}
          </div>
          {lang === 'en' && (
            <p class="local-time" hidden>
              Local time in Bergamo: <time>--:--</time>
            </p>
          )}
        </div>
      </div>

      <div class="section-header links-section-header">
        <h2>{t(lang, 'about.links.title')}</h2>
      </div>

      <ul class="links">
        {SOCIAL_LINKS.map((link) => (
          <li>
            <a href={link.href} target={link.target} rel={link.rel}>
              <img src={link.iconUrl} alt="" class="link-img" decoding="async" loading="lazy" />
              {link.name}
              {link.target && <ExternalArrow />}
            </a>
          </li>
        ))}
      </ul>

      <CtaRow lang={lang} />
    </div>
  </section>
  <script>
    // English page only: tells visitors abroad what time it is here before they write.
    const localTime = document.querySelector<HTMLElement>('.local-time');
    if (localTime) {
      const clock = localTime.querySelector('time')!;
      const format = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Europe/Rome',
        hour: '2-digit',
        minute: '2-digit',
      });
      // Re-armed on each minute boundary, so the clock never lags the real minute
      const tick = () => {
        clock.textContent = format.format(new Date());
        setTimeout(tick, 60_000 - (Date.now() % 60_000));
      };
      tick();
      localTime.hidden = false;
    }
  </script>
</Base>

<style>
  .about-page {
    padding: 5rem var(--gutter);
  }

  .about-inner {
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .profile-row {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
  }

  .avatar {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border);
    flex-shrink: 0;
  }

  @media (min-width: 769px) {
    .avatar {
      width: 140px;
      height: 140px;
    }
  }

  .section-header {
    margin-bottom: 1rem;
  }

  .section-header h1 {
    color: var(--text);
  }

  /* Subheading keeps the h3 size it was designed at; ruled like the /experience sections */
  .section-header h2 {
    font-size: 1.15rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .links-section-header {
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .bio p {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .local-time {
    margin-top: 1rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }

  .bio p + p {
    margin-top: 1rem;
  }

  /* One line of profiles, wrapping where the screen is narrow */
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2rem;
  }

  .links a {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    /* Tall enough to tap */
    padding-block: 0.6rem;
    color: var(--text);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .links a:hover {
    color: var(--accent);
  }

  .link-img {
    width: 20px;
    height: 20px;
    object-fit: contain;
    flex-shrink: 0;
    margin-right: 0.35rem;
  }

  @media (max-width: 768px) {
    .about-page {
      padding: 3rem var(--gutter);
    }

    .profile-row {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .bio p {
      text-align: left;
    }
  }

  @media (max-width: 480px) {
    .about-page {
      padding: 2rem var(--gutter);
    }
  }
</style>
