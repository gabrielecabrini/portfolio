---
import Base from '../../layouts/Base.astro';
import { EMAIL, PGP_LINK, SOCIAL_LINKS } from '../../data/social-links';
import { langPaths, localePath, pageLang, t } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = pageLang(Astro.params.lang);
const links = [...SOCIAL_LINKS, { ...PGP_LINK, href: localePath(lang, PGP_LINK.href) }];
---

<Base lang={lang} title={t(lang, 'title.about')} description={t(lang, 'about.seo.description')}>
  <section class="about-page">
    <div class="about-inner">
      <div class="profile-row enter">
        <img class="avatar" src="/assets/images/pfp.jpeg" alt="Gabriele Cabrini" decoding="async" />
        <div>
          <div class="section-header">
            <h1>{t(lang, 'about.title')}</h1>
          </div>
          <div class="bio">
            {t(lang, 'about.bio')
              .split('\n')
              .map((paragraph) => (
                <p>{paragraph}</p>
              ))}
          </div>
          {lang === 'en' && (
            <p class="local-time" hidden>
              Local time in Bergamo: <time>--:--</time>
            </p>
          )}
        </div>
      </div>

      <blockquote class="quote enter" style="--i: 1">
        <p>
          Any fool can write code that a computer can understand. Good programmers write code that
          humans can understand.
        </p>
        <cite>— Martin Fowler</cite>
      </blockquote>

      <div class="section-header links-section-header enter" style="--i: 2">
        <h2>{t(lang, 'about.links.title')}</h2>
      </div>

      <div class="links-grid enter" style="--i: 2">
        {links.map((link) => (
          <a href={link.href} target={link.target} rel={link.rel} class="link-card">
            <span class="link-icon">
              <img
                src={link.iconUrl}
                alt={link.name}
                class="link-img"
                decoding="async"
                loading="lazy"
              />
            </span>
            <span class="link-name">{link.name}</span>
            <span class="link-arrow">{link.target ? '↗' : '→'}</span>
          </a>
        ))}
      </div>

      <hr class="cta-divider enter" style="--i: 3" />

      <div class="ctas-row enter" style="--i: 3">
        <a href={EMAIL.href} class="contact-cta">
          <div class="contact-cta-left">
            <p class="contact-cta-heading">{t(lang, 'about.contact.heading')}</p>
            <p class="contact-cta-hint">
              <span class="contact-dot" aria-hidden="true"></span>
              {t(lang, 'about.contact.hint')}
            </p>
          </div>
          <span class="contact-cta-btn">{t(lang, 'about.contact.cta')} ↗</span>
        </a>

        <a href={localePath(lang, '/cv')} class="contact-cta">
          <div class="contact-cta-left">
            <p class="contact-cta-heading">{t(lang, 'about.cv.link')}</p>
            <p class="contact-cta-hint">{t(lang, 'about.cv.hint')}</p>
          </div>
          <span class="contact-cta-btn">{t(lang, 'about.cv.cta')} ↗</span>
        </a>
      </div>
    </div>
  </section>
  <script>
    // English page only: tells visitors abroad what time it is here before they write.
    const localTime = document.querySelector<HTMLElement>('.local-time');
    if (localTime) {
      const clock = localTime.querySelector('time')!;
      const format = new Intl.DateTimeFormat('en-GB', {
        timeZone: 'Europe/Rome',
        hour: '2-digit',
        minute: '2-digit',
      });
      // Re-armed on each minute boundary, so the clock never lags the real minute
      const tick = () => {
        clock.textContent = format.format(new Date());
        setTimeout(tick, 60_000 - (Date.now() % 60_000));
      };
      tick();
      localTime.hidden = false;
    }
  </script>
</Base>

<style>
  .about-page {
    padding: 5rem 1.5rem;
  }

  .about-inner {
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .profile-row {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: 0;
  }

  .avatar {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border);
    flex-shrink: 0;
  }

  @media (min-width: 769px) {
    .avatar {
      width: 140px;
      height: 140px;
    }
  }

  .section-header {
    margin-bottom: 1rem;
  }

  .section-header h1 {
    color: var(--text);
  }

  /* Subheading keeps the h3 size it was designed at */
  .section-header h2 {
    color: var(--text);
    font-size: 1.15rem;
  }

  .quote {
    margin-top: 3rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--accent);
    color: var(--muted);
    font-style: italic;
  }

  .quote cite {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-style: normal;
  }

  .links-section-header {
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .bio {
    margin-bottom: 0;
  }

  .bio p {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .local-time {
    margin-top: 1rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }

  .bio p + p {
    margin-top: 1rem;
  }

  .links-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .cta-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0 0;
  }

  .link-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    transition:
      border-color 0.15s,
      background 0.15s;
    /* min touch target height */
    min-height: 52px;
  }

  .link-card:hover {
    border-color: var(--accent);
    background: var(--surface-hover);
    color: var(--text);
  }

  .link-icon {
    color: var(--muted);
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }

  .link-card:hover .link-icon {
    color: var(--accent);
  }

  .link-card:hover .link-arrow {
    transform: translateX(3px);
  }

  .link-img {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }

  .link-name {
    font-weight: 500;
    font-size: 0.95rem;
    flex: 1;
    /* prevent long email from overflowing */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .link-arrow {
    color: var(--muted);
    font-size: 0.9rem;
    transition: transform 0.2s ease;
  }

  /* ── CTAs row (contact + CV) ── */

  .ctas-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }

  .contact-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.4rem 1.6rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    transition:
      border-color 0.15s,
      background 0.15s;
  }

  .contact-cta:hover {
    border-color: var(--accent);
    background: var(--surface-hover);
    color: var(--text);
  }

  .contact-cta-heading {
    font-size: 0.95rem;
    font-weight: 500;
    margin-bottom: 0.3rem;
    max-width: none;
  }

  .contact-cta-hint {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--muted);
    max-width: none;
  }

  .contact-dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #22c55e;
    animation: avail-pulse 1.8s ease-out infinite;
  }

  .contact-cta-btn {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--accent);
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .about-page {
      padding: 3rem 1rem;
    }

    .profile-row {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .bio p {
      text-align: left;
    }

    .links-grid {
      grid-template-columns: 1fr;
    }

    .ctas-row {
      grid-template-columns: 1fr;
    }

    .contact-cta {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }

  @media (max-width: 480px) {
    .about-page {
      padding: 2rem 1rem;
    }
  }
</style>
